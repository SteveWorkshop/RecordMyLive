<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/app_page_navigation"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="rachel.materialapps.recordmylive.ui.pages.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/statisticsFragment"
        android:name="rachel.materialapps.recordmylive.ui.pages.statistics.StatisticsFragment"
        android:label="fragment_statistics"
        tools:layout="@layout/fragment_statistics" />
    <fragment
        android:id="@+id/myFragment"
        android:name="rachel.materialapps.recordmylive.ui.pages.my.MyFragment"
        android:label="fragment_my"
        tools:layout="@layout/fragment_my" />
    <fragment
        android:id="@+id/addConcertFragment"
        android:name="rachel.materialapps.recordmylive.ui.pages.home.AddConcertFragment"
        android:label="AddConcertFragment" />
    <fragment
        android:id="@+id/detailFragment"
        android:name="rachel.materialapps.recordmylive.ui.pages.home.DetailFragment"
        android:label="DetailFragment">
        <action
            android:id="@+id/action_detail_to_edit"
            app:destination="@id/addConcertFragment" />
    </fragment>
    <fragment
        android:id="@+id/timeLineFragment"
        android:name="rachel.materialapps.recordmylive.ui.pages.timeline.TimeLineFragment"
        android:label="fragment_time_line"
        tools:layout="@layout/fragment_time_line" />
</navigation>
